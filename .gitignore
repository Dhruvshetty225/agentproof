# Virtual environments
.venv/
venv/
env/

# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artifacts
*.egg-info/
.eggs/
build/
dist/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated AgentProof reports
*-report.html

# Official SARIF schema, downloaded by scripts/fetch_sarif_schema.sh (OASIS
# terms, not committed)
tests/schemas/

# Real pull-request data collected by eval/collect.py: third-party code under
# many licenses, so it stays local. eval/manifest.csv pins it for re-fetching.
eval/data/

# demo-app is its own git repo (main/ai-fix fixture history) —
# tracked independently, not as part of this repo's tree.
demo-app/

# Editor / OS cruft
.DS_Store
.idea/
.vscode/
